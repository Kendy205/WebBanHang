@model WebBanHang.Models.Models.Order

@{

    ViewData["Title"] = "Chi tiết đơn hàng " + (Model?.OrderCode ?? "");
}

<div class="container my-4">

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-light py-3">
            <h4 class="m-0 fw-semibold">Chi tiết đơn hàng: @Model.OrderCode</h4>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-lg-6">
                    <h5 class="mb-3 fw-semibold">Thông tin đơn hàng</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Trạng thái:</dt>
                        <dd class="col-sm-9">@Model.Status</dd>

                        <dt class="col-sm-3">Ngày tạo:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Tổng tiền:</dt>
                        <dd class="col-sm-9 fw-bold text-danger">@($"{Model.TotalAmount:N0} ₫")</dd>
                    </dl>
                </div>

                <div class="col-lg-6">
                    <h5 class="mb-3 fw-semibold">Thông tin giao hàng</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Giao đến:</dt>
                        <dd class="col-sm-9">@Model.ShippingAddress</dd>

                        <dt class="col-sm-3">Điện thoại:</dt>
                        <dd class="col-sm-9">@Model.PhoneNumber</dd>

                        <dt class="col-sm-3">Thanh toán:</dt>
                        <dd class="col-sm-9">@Model.PaymentMethod</dd>

                        <dt class="col-sm-3">Ghi chú:</dt>
                        <dd class="col-sm-9 fst-italic">@(Model.Notes ?? "Không có")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>


    <h4 class="mt-4">Sản phẩm</h4>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Món</th>
                        <th style="width:120px" class="text-center">Số Lượng</th>
                        <th style="width:160px" class="text-end">Đơn giá</th>
                        <th style="width:180px" class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var items = Model?.OrderDetails ?? Enumerable.Empty<WebBanHang.Models.Models.OrderDetail>();
                        if (!items.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted p-4">Đơn hàng chưa có sản phẩm</td></tr>
                        }
                        else
                        {
                            foreach (var it in items)
                            {
                                var name = it.Food?.FoodName ?? it.FoodName;
                                <tr>
                                    <td>@name</td>
                                    <td class="text-center">@it.Quantity</td>
                                    <td class="text-end">@($"{it.Price:N0} ₫")</td>
                                    <td class="text-end">@($"{(it.Price * it.Quantity):N0} ₫")</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary">
            ← Quay lại danh sách
        </a>
        <div class="fs-5 m-0">
            Tổng cộng: <b class="text-danger fw-bold">@($"{Model.TotalAmount:N0} ₫")</b>
        </div>
    </div>

</div>
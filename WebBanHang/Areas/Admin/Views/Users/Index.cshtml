@using WebBanHang.DAL.Data
@{
    var userRole = ViewBag.UserRoles;
    string Badge(string s) => s switch
    {
        "Admin" => "badge badge-gradient-danger",
        "Customer" => "badge badge-gradient-info",
        _ => "badge badge-gradient-info"
    };
}
@model IEnumerable<ApplicationUser>
<partial name="_toastr" />
<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="page-header">
                    <h3 class="page-title"> Danh sách người dùng </h3>
                    <a class="btn btn-primary" asp-action="Create"><i class="mdi mdi-plus"></i> Thêm người dùng</a>
                </div>
                
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th> Người dùng </th>
                                    <th> Họ và tên </th>
                                    <th> Quyền hạn </th>
                                    <th> Cập nhật lần cuối </th>

                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ApplicationUser u in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (@u.imgUrl != null)
                                            {
                                                <img src="@u.imgUrl" class="me-2" alt="@u.FulName">

                                            }
                                            else
                                            {
                                                <span>No img</span>
                                            }

                                        </td>
                                        <td> @u.FulName</td>
                                        <td>
                                        <label class="@Badge(string.Join(", ", (List<string>)userRole[@u.Id]))">@string.Join(", ", (List<string>)userRole[@u.Id])</label>
                                        </td>
                                        <td> @u.UpdateAt </td>

                                        <td class="text-center">
                                            <a asp-action="Details" asp-route-userId="@u.Id" class="btn btn-sm btn-info"><i class="mdi mdi-eye"></i></a>
                                            <a asp-action="Edit" asp-route-userId="@u.Id" class="btn btn-sm btn-warning"><i class="mdi mdi-pencil"></i></a>
                                            <a asp-action="Delete" asp-route-userId="@u.Id" class="btn btn-sm btn-danger"><i class="mdi mdi-delete"></i></a>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                
            </div>
        </div>
    </div>
</div>

@section PhanTrang {
    @if (ViewBag.totalPages > 1)
    {
        <div class="product__pagination">
            @for (int i = 1; i <= ViewBag.totalPages; i++)
            {

                <a class="@(i==ViewBag.CurrentPage ? "press":"")"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-categoryId="@ViewBag.CurrentCategory">
                    @i
                </a>

            }

        </div>

    }

}
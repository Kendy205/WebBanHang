@model WebBanHang.DAL.Data.ApplicationUser

@{
    ViewData["Title"] = "Xác nhận xóa người dùng";
}

<h4>@ViewData["Title"]</h4>
<p class="text-danger">Bạn có chắc chắn muốn xóa vĩnh viễn người dùng này không? Hành động này không thể hoàn tác.</p>
<hr />
<div class="page-header">
    <h3 class="page-title"> Chi tiết người dùng </h3>
</div>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.imgUrl))
                {
                    <img src="@Model.imgUrl" alt="image" class="img-fluid rounded shadow" />
                }
                else
                {
                    <p class="text-muted">Không có ảnh</p>
                }
            </div>
            <div class="col-md-8">
                <h4> <b>Họ tên</b> : @Model.FulName</h4>
                <p><b>Email</b> : @Model.Email</p>
                <p><b>Phone</b> : @Model.PhoneNumber</p>
                <p><b>Địa chỉ:</b> @Model.Address</p>
                <p>
                    <b>Quyền :</b>
                    @{
                        var roles = "Không có quyền nào";
                        if (ViewBag.UserRoles != null && ((IEnumerable<string>)ViewBag.UserRoles).Any())
                        {
                            roles = string.Join(", ", (IEnumerable<string>)ViewBag.UserRoles);
                        }
                    }
                    @roles
                </p>
                <p><b>Ngày tạo:</b> @Model.CreateAt</p>
            </div>
        </div>
        <a asp-action="Edit" asp-route-userId="@Model.Id" class="btn btn-warning mt-3">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>

        <form asp-action="DeleteConfirmed" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.Id" />
            <div class="row justify-content-end" >
                <div class="col-lg-2 col-md-3 cl-sm-4 ">
                    <button type="submit" class="btn btn-gradient-danger btn-lg font-weight-medium">Xác nhận Xóa</button>
                </div>
            </div>
        </form>

    </div>
</div>

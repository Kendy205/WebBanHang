@using WebBanHang.Models.Models
@model IEnumerable<Category>
<style>
    .categories__item {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        border-radius: 10px;
        margin: 10px;
    }

        .categories__item h5 {
            position: absolute;
            color: #fff;
            background: rgba(0, 0, 0, 0.5);
            padding: 5px 10px;
            border-radius: 5px;
        }

            .categories__item h5:hover {
                background-color: rgb(127, 173, 57);
            }

        .categories__item.set-bg {
            background-size: cover;
            background-position: center;
        }
</style>
<!-- Categories Section Begin -->
<section class="categories">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2 style="color: rgb(127, 173, 57)">Danh Mục</h2>
                </div>
                <div class="categories__slider owl-carousel">
                    @foreach (Category c in Model)
                    {
                        <div class="col-lg-3">
                            <div class="categories__item set-bg" data-setbg="@c.ImageUrl">
                                <h5><a asp-area="Customer" asp-controller="Food" asp-action="Category" asp-route-id="@c.CategoryId">@c.CategoryName</a></h5>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->
